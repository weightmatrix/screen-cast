    "将这台 iPad 的画面分享给 Mac 或另一台 iPad": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此 iPad 畫面分享給 Mac 或另一台 iPad"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this iPad with a Mac or another iPad"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte este iPad con un Mac u otro iPad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPad mit einem Mac oder iPad teilen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez cet iPad avec un Mac ou un autre iPad"
          }
        },
        "it": {
