        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면을 공유하거나 다른 기기의 화면 수신"
          }
        }
      }
    },
    "接收端连接这一路投屏后，会显示在这里。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接收端連接此路投屏後，會顯示於此。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receivers of this stream appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los receptores de esta transmisión aparecen aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfänger dieses Streams erscheinen hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récepteurs de cette diffusion apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ricevitori di questa trasmissione appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この配信の受信デバイスがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전송의 수신 기기가 여기에 표시됩니다."
          }
        }
      }
    },
    "开始系统广播后生成局域网地址。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始系統廣播後產生區域網路位址。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local address is created when broadcasting starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección local se genera al iniciar la difusión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Adresse wird beim Broadcast-Start erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse locale est créée au début de la diffusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo locale viene creato all’avvio della trasmissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信開始後にLANアドレスが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송을 시작하면 로컬 주소가 생성됩니다."
          }
        }
      }
    },
    "点击左侧系统录屏按钮": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊左側系統錄影按鈕"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the system recording button on the left"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón de grabación a la izquierda"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemaufnahmetaste links antippen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton d’enregistrement à gauche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante di registrazione a sinistra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左のシステム録画ボタンをタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 시스템 녹화 버튼을 누르세요"
          }
        }
      }
    },
    "接收设备选择匹配码连接。投屏包含屏幕上的所有可采集内容，请先关闭不想分享的信息。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接收裝置以配對碼連線。投屏包含螢幕上所有可擷取內容，請先關閉不想分享的資訊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receivers connect using the pairing code. Everything capturable on screen is shared; hide private information first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los receptores usan el código. Se comparte todo lo capturable en pantalla; oculta antes la información privada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfänger verbinden sich per Code. Alle erfassbaren Bildschirminhalte werden geteilt; private Informationen vorher schließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récepteurs utilisent le code. Tout contenu capturable est partagé ; masquez d’abord les informations privées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ricevitori usano il codice. Tutto ciò che può essere acquisito viene condiviso; nascondi prima i dati privati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信側はコードで接続します。取得可能な画面内容はすべて共有されます。私的な情報は事前に閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신 기기는 코드로 연결합니다. 캡처 가능한 모든 화면 내용이 공유되므로 비공개 정보를 먼저 닫으세요."
          }
        }
      }
    },
    "浏览器打开地址后点击开始接收；公网须开启广域网匹配码，画面不经服务器。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器開啟位址後點擊開始接收；公網須啟用廣域網配對碼，畫面不經伺服器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the address in a browser and start receiving. Internet use requires pairing and sender approval; video bypasses the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la dirección e inicia la recepción. Por Internet se requiere emparejamiento y aprobación; el vídeo no pasa por el servidor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse im Browser öffnen und Empfang starten. Internet erfordert Kopplung und Freigabe; Video läuft direkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’adresse et lancez la réception. Internet exige association et approbation ; la vidéo est directe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’indirizzo e avvia la ricezione. Internet richiede abbinamento e approvazione; il video è diretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでアドレスを開き受信を開始します。インターネットではペアリングと承認が必要です。映像はサーバーを経由しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 주소를 열고 수신을 시작하세요. 인터넷에서는 페어링과 승인이 필요하며 영상은 서버를 거치지 않습니다."
          }
        }
      }
    },
    "需要发送端可达的公网地址和映射端口；不经过配对服务器。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要可連至投送端的公網位址及對應連接埠；不經配對伺服器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a reachable public address and mapped port. Pairing is direct; sender approval is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere una dirección pública accesible y un puerto asignado. La aprobación del emisor es necesaria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert erreichbare öffentliche Adresse und Portfreigabe. Direkte Kopplung mit Senderfreigabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige une adresse publique accessible et un port redirigé. Association directe avec accord de l’émetteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede indirizzo pubblico raggiungibile e porta mappata. Abbinamento diretto con approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到達可能な公開アドレスとポート転送が必要です。直接ペアリング後、送信者の承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접속 가능한 공인 주소와 포트 매핑이 필요합니다. 직접 페어링 후 전송자 승인이 필요합니다."
          }
        }
      }
    },
    "服务器检查时未被占用；采用后请让接收端输入新码。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器檢查時尚未使用；採用後請讓接收端輸入新碼。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available when checked. Receivers must use the new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible al comprobarlo. Los receptores deben usar el nuevo código."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Prüfung frei. Empfänger müssen den neuen Code nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible lors de la vérification. Utilisez le nouveau code côté réception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile alla verifica. I ricevitori devono usare il nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認時点では未使用です。受信側で新しいコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 시 사용 가능한 코드입니다. 수신 기기에 새 코드를 입력하세요."
          }
        }
      }
    },
    "另一台发送设备正在使用这个匹配码。请停止那台设备的广播，或为本机换码后让接收端输入新码。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台投送裝置正使用此配對碼。請停止其廣播，或在本機換碼並讓接收端輸入新碼。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another sender uses this code. Stop that broadcast or choose a new code and update the receivers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro emisor usa este código. Detén su difusión o elige otro código y actualiza los receptores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Sender nutzt diesen Code. Dessen Broadcast stoppen oder einen neuen Code wählen und den Empfängern mitteilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre émetteur utilise ce code. Arrêtez sa diffusion ou changez le code et informez les récepteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro mittente usa questo codice. Ferma quella trasmissione o cambia codice e aggiorna i ricevitori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の送信デバイスがこのコードを使用中です。その配信を停止するか、新しいコードを受信側に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 전송 기기가 이 코드를 사용 중입니다. 해당 방송을 중지하거나 코드를 바꾸고 수신 기기에 알려주세요."
          }
        }
      }
    },
    "话筒需先在系统广播面板打开麦克风；此处可随时静音或恢复。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先於系統廣播面板開啟麥克風；此處可隨時靜音或恢復。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the microphone in the system broadcast panel first. You can mute or unmute it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa primero el micrófono en el panel del sistema. Aquí puedes silenciarlo o reactivarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon zuerst im System-Broadcast aktivieren. Hier stumm schalten oder aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d’abord le microphone dans le panneau système. Vous pouvez ensuite le couper ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva prima il microfono nel pannello di sistema. Qui puoi disattivarlo o riattivarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にシステム配信パネルでマイクをオンにしてください。ここでミュートを切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 방송 패널에서 먼저 마이크를 켜세요. 여기서 음소거를 전환할 수 있습니다."
          }
        }
      }
    },
    "按最长边限制，保持画面比例。原生使用系统提供的尺寸；更高分辨率会增加设备和网络负担。设置在下次广播生效。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "限制最長邊並保持比例。原生採系統尺寸；較高解析度增加裝置及網路負擔。下次廣播生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits the longest edge, preserving aspect ratio. Native uses system dimensions. Higher resolutions use more resources. Applies next broadcast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita el lado mayor manteniendo la proporción. Nativo usa el tamaño del sistema. Una mayor resolución consume más recursos. Se aplica en la próxima difusión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Längste Kante begrenzt, Seitenverhältnis bleibt. Nativ nutzt Systemmaße. Höhere Auflösung braucht mehr Ressourcen. Gilt ab nächstem Broadcast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite le grand côté en conservant les proportions. Natif utilise les dimensions système. Une résolution élevée consomme davantage. Applicable à la prochaine diffusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita il lato maggiore mantenendo le proporzioni. Nativo usa le dimensioni di sistema. Risoluzioni elevate richiedono più risorse. Vale dalla prossima trasmissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦横比を保ち長辺を制限します。ネイティブはシステムの寸法を使用します。高解像度は負荷が増えます。次回の配信から適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비율을 유지하며 긴 변을 제한합니다. 기본 해상도는 시스템 크기를 사용합니다. 고해상도는 부하를 늘립니다. 다음 방송부터 적용됩니다."
          }
        }
      }
    },
    "在系统弹窗中确认开始后，可以切换到其他应用继续投屏。系统不允许静默启动录屏；受保护的视频可能不会显示。声音可分别选择页面与话筒。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統視窗確認開始後，可切換其他應用程式繼續投屏。不可靜默啟動錄影；受保護影片可能不顯示。可分別選擇頁面與麥克風聲音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm in the system dialog, then switch apps while sharing. Recording cannot start silently. Protected video may be hidden. Device and microphone audio are separate options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma en el diálogo del sistema y cambia de aplicación. No hay grabación silenciosa. Los vídeos protegidos pueden ocultarse. El audio del dispositivo y del micrófono se eligen por separado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Systemdialog bestätigen, dann Apps wechseln. Aufnahme startet nicht unbemerkt. Geschütztes Video kann ausgeblendet sein. Geräte- und Mikrofonton sind separat wählbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez dans le dialogue système, puis changez d’app. Pas d’enregistrement silencieux. Les vidéos protégées peuvent être masquées. Sons de l’appareil et du micro sont séparés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma nel dialogo di sistema, poi cambia app. La registrazione non parte di nascosto. I video protetti potrebbero essere nascosti. Audio dispositivo e microfono sono separati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムで開始を確認後、他のアプリに切り替えられます。録画は無断で開始しません。保護された映像は表示されない場合があります。デバイスとマイクの音声を個別に選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 창에서 시작을 확인한 후 다른 앱으로 전환할 수 있습니다. 녹화는 몰래 시작되지 않습니다. 보호된 영상은 표시되지 않을 수 있습니다. 기기와 마이크 오디오는 따로 선택합니다."
          }
        }
      }
    },
    "RTT是设备间网络往返时间；接收处理是最近采样期间每帧的缓冲与解码平均耗时。均不是端到端总延迟；无有效样本时显示—。": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RTT為裝置間網路往返時間；接收處理為近期每影格緩衝與解碼平均耗時。皆非端對端總延遲；無有效樣本時顯示—。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RTT is network round-trip time. Receive processing averages per-frame buffering and decoding. Neither is total end-to-end latency. A dash means no valid sample."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RTT mide la ida y vuelta. El procesamiento promedia búfer y decodificación por fotograma. Ninguno es la latencia total. Un guion indica que no hay muestras válidas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RTT ist die Netzwerk-Rundlaufzeit. Empfangsverarbeitung mittelt Pufferung und Dekodierung je Bild. Beides ist keine Gesamtlatenz. Ein Strich bedeutet: kein gültiger Messwert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RTT : aller-retour réseau. Traitement : moyenne de mise en mémoire et décodage par image. Aucun ne mesure la latence totale. Un tiret indique l’absence de mesure valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RTT indica l’andata e ritorno di rete. L’elaborazione media buffer e decodifica per fotogramma. Nessuno indica la latenza totale. Il trattino indica un campione non disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RTTはネットワーク往復時間です。受信処理はフレームごとのバッファとデコードの平均です。いずれも全遅延ではありません。有効な値がない場合は—を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RTT는 네트워크 왕복 시간입니다. 수신 처리는 프레임당 버퍼링과 디코딩 평균입니다. 둘 다 전체 지연 시간이 아닙니다. 유효한 표본이 없으면 —가 표시됩니다."
          }
        }
      }
    },
