    "正在连接发送端…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在連線投送端…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to sender…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando al emisor…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Sender…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à l’émetteur…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione al mittente…"
          }
        },
        "ja": {
