        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPad 화면을 Mac 또는 다른 iPad에 공유"
          }
        }
      }
    },
    "整屏投屏，或接收另一台设备的画面": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個螢幕投屏，或接收另一台裝置畫面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your screen or receive another device’s screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu pantalla o recibe la de otro dispositivo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm teilen oder anderen Bildschirm empfangen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre écran ou recevez celui d’un autre appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi lo schermo o ricevi quello di un altro dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体を共有、または別のデバイスの画面を受信"
